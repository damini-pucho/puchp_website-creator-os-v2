# PostgREST config for Website Creator OS V2 — copy to postgrest.conf and fill in.
# Docs: https://postgrest.org/en/stable/references/configuration.html
#
# Run locally:   postgrest postgrest.conf
# Run in Docker: docker run --rm -p 3001:3001 \
#                  -e PGRST_DB_URI="postgres://wco_authenticator:PASSWORD@HOST:5432/DBNAME" \
#                  -e PGRST_DB_SCHEMAS=public -e PGRST_DB_ANON_ROLE=wco_web -e PGRST_SERVER_PORT=3001 \
#                  postgrest/postgrest
#
# The app reads this API's URL from VITE_DB_API_URL; the Pucho Studio HTTP steps
# call <this URL>/clients?id=eq.<clientId>.

# Login role from database/postgres/003_postgrest_roles.sql (add ?sslmode=require for RDS)
db-uri = "postgres://wco_authenticator:PASSWORD@localhost:5432/website_creator_os_v2_dev"
db-schemas = "public"
db-anon-role = "wco_web"

server-port = 3001

# Browser origins allowed to call the API (the app's dev URL and production URL)
server-cors-allowed-origins = "http://localhost:5173, https://website-creator-os.myapps.pucho.ai"
