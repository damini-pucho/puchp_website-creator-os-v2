# Website Creator OS V2 - environment example (copy to .env)

# Data API: the app calls /api/db on its own domain (nginx -> PostgREST in the container;
# npm run dev proxies it to PostgREST on localhost:3001). Set only to use another API URL.
# VITE_DB_API_URL=https://db-api.example.com

# Direct PostgreSQL connection, for npm run db:api and database/postgres/*.sql (add ?sslmode=require for RDS)
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/website_creator_os_v2_dev

# Pucho AI Studio flow webhooks (server side only; /sync is added for the build flow automatically)
PLANNING_WORKFLOW_WEBHOOK_URL=https://studio.pucho.ai/api/v1/webhooks/<planning-flow-id>
BUILD_WORKFLOW_WEBHOOK_URL=https://studio.pucho.ai/api/v1/webhooks/<build-flow-id>

# Production app URL (sent to the flows as X-App-Url; VITE_APP_URL is built into the app)
APP_URL=https://website-creator-os-2.myapps.pucho.ai/
VITE_APP_URL=https://website-creator-os-2.myapps.pucho.ai/

# Inbound webhook token (server side only, no VITE_ prefix): 16-256 chars of A-Z a-z 0-9 . _ ~ + / = -
INBOUND_TOKEN=CHANGE_ME_generate_a_long_random_token

# Application Settings
VITE_APP_NAME="Website Creator OS V2"
VITE_APP_VERSION="2.0.0"
VITE_ENVIRONMENT=development
